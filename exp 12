#include <stdio.h>
#include <string.h>

#define MAX 100

// Function for binary search in a sorted array of names
int binarySearch(char arr[][50], int n, char target[]) {
    int low = 0, high = n - 1;
    
    while (low <= high) {
        int mid = (low + high) / 2;
        int cmp = strcmp(arr[mid], target); // Compare strings

        if (cmp == 0)
            return mid;  // Found
        else if (cmp < 0)
            low = mid + 1;  // Search right half
        else
            high = mid - 1; // Search left half
    }
    return -1; // Not found
}

int main() {
    int n;
    char names[MAX][50], target[50];

    printf("Enter number of contacts: ");
    scanf("%d", &n);

    printf("Enter names in sorted order:\n");
    for (int i = 0; i < n; i++) {
        scanf("%s", names[i]);
    }

    printf("Enter name to search: ");
    scanf("%s", target);

    int index = binarySearch(names, n, target);

    if (index != -1)
        printf("Contact '%s' found at position %d.\n", target, index + 1);
    else
        printf("Contact '%s' not found.\n", target);

    return 0;
}
